# ==========================================================
# Sony Feeding Kurtis - Environment Configuration Template
# Copy to .env and configure secret credentials before running.
# NEVER commit actual .env files to source control!
# ==========================================================

# 1. Django Core Settings
DEBUG=False
SECRET_KEY=generate_a_cryptographically_secure_50_char_secret_key_here
ALLOWED_HOSTS=sonyfeedingkurtis.com,www.sonyfeedingkurtis.com,api.sonyfeedingkurtis.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://sonyfeedingkurtis.com,https://www.sonyfeedingkurtis.com
DJANGO_SETTINGS_MODULE=core.production_settings

# 2. Production PostgreSQL Database
POSTGRES_DB=sony_db
POSTGRES_USER=sony_user
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 3. HTTPS & Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# 4. Google OAuth 2.0 Web Client Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# 5. Razorpay Merchant Credentials
# Test keys start with: rzp_test_... | Live keys start with: rzp_live_...
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_key

# 6. SMTP Email Credentials (e.g. Gmail / Brevo / AWS SES)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sonycollections00@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=Sony Feeding Kurtis <sonycollections00@gmail.com>
